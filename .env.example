# Copy to .env for local development:  cp .env.example .env
# NEVER commit your real .env — it is gitignored.

# SQLite for local dev (Postgres in Docker/production — see .env.docker.example)
DATABASE_URL="file:./prisma/dev.db"

# Required. Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Optional: plug in any OpenAI-compatible LLM for live agent chat.
# Leave LLM_API_KEY blank to use the built-in offline expert engine (fully functional).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Production only — set to your domain for real passkeys/WebAuthn:
# WEBAUTHN_RP_ID=wiz-agents.com
# WEBAUTHN_ORIGIN=https://wiz-agents.com
