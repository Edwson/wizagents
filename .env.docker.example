# Copy to .env, fill values, then: docker compose up -d --build
POSTGRES_PASSWORD=use-a-long-random-string
AUTH_SECRET=generate-with-openssl-rand-base64-48
# For real biometric/passkeys in production, set these to your domain:
WEBAUTHN_RP_ID=wiz-agents.com
WEBAUTHN_ORIGIN=https://wiz-agents.com
# Optional: plug in any OpenAI-compatible LLM for live agent chat (blank = offline engine)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
